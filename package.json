{
  "name": "roam",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --workspaces dev",
    "dev:web": "bun run --filter '@roam/www' dev",
    "dev:api": "bun run --filter '@roam/api' dev",
    "build": "bun run --filter '@roam/www' build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "framer-motion": "^13.4.4",
    "next-themes": "^0.4.6"
  }
}
