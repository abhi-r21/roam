{
  "name": "yuvly",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --workspaces dev",
    "dev:web": "bun run --filter '@yuvly/www' dev",
    "dev:api": "bun run --filter '@yuvly/api' dev",
    "build": "bun run --filter '@yuvly/www' build",
    "lint": "bun run --filter '@yuvly/www' lint"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
